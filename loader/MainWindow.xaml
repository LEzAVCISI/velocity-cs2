<Window x:Class="VelocityLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="if3b" Height="430" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Custom Skeet Styled Controls -->
        <SolidColorBrush x:Key="BgElevated" Color="#0E0E10"/>
        <SolidColorBrush x:Key="BgCard" Color="#131316"/>
        <SolidColorBrush x:Key="BgDark" Color="#0B0B0D"/>
        <SolidColorBrush x:Key="AccentGold" Color="#E8AC30"/>
        <SolidColorBrush x:Key="AccentGoldDim" Color="#C48C20"/>
        <SolidColorBrush x:Key="BorderCol" Color="#28282D"/>
        <SolidColorBrush x:Key="TextMain" Color="#E0E0E6"/>
        <SolidColorBrush x:Key="TextDim" Color="#787882"/>

        <Style x:Key="SkeetTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeetPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeetButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#1E1E24" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#E8AC30" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.98" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.98" Duration="0:0:0.08"/>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#2A2A32" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="2.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="2.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Skeet Multi-Layer Border Container -->
    <Border Background="{StaticResource BgElevated}" 
            BorderBrush="#000000" 
            BorderThickness="1" 
            SnapsToDevicePixels="True">
        
        <Border BorderBrush="#323232" BorderThickness="1">
            <Border BorderBrush="#161616" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Skeet Gradient Accent Bar (Top of window) -->
                    <Border Grid.Row="0" Height="2.5" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8AC30" Offset="0.0"/>
                                <GradientStop Color="#C48C20" Offset="0.5"/>
                                <GradientStop Color="#E8AC30" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Top Title Bar -->
                    <Grid Grid.Row="1" Margin="10,6,10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✦" Foreground="{StaticResource AccentGold}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="if3b" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Content="✕" Width="22" Height="20" HorizontalAlignment="Right" 
                                Style="{StaticResource SkeetButton}" Padding="0" 
                                Click="CloseButton_Click" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextDim}"/>
                    </Grid>

                    <!-- Main Content Area -->
                    <Grid Grid.Row="2" Margin="12,2,12,12">
                        <!-- Card Background -->
                        <Border Background="{StaticResource BgCard}" 
                                BorderBrush="{StaticResource BorderCol}" 
                                BorderThickness="1" 
                                Padding="16">

                            <Grid>
                                <!-- WELCOME OVERLAY (Opening animation) -->
                                <Grid x:Name="WelcomeOverlay" Visibility="Visible" Panel.ZIndex="10" Background="{StaticResource BgCard}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="✦" Foreground="{StaticResource AccentGold}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock x:Name="WelcomeText" Text="welcome, user" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="wow, if3b is goated" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- SAYONARA OVERLAY (Closing animation) -->
                                <Grid x:Name="SayonaraOverlay" Visibility="Collapsed" Panel.ZIndex="20" Background="{StaticResource BgCard}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="sayonara" Foreground="{StaticResource AccentGold}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="SayonaraSubText" Text="see you later" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- LOGGED IN DASHBOARD -->
                                <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- MEMBERSHIP / LAUNCH -->
                                    <StackPanel x:Name="MembershipTabContent" Grid.Row="0" Visibility="Visible" VerticalAlignment="Center">
                                        <!-- User Info Block -->
                                        <Border x:Name="UserInfoCard" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderCol}" BorderThickness="1" Padding="12" Margin="0,0,0,18" Opacity="0">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="10"/>
                                            </Border.RenderTransform>
                                            <StackPanel>
                                                <TextBlock x:Name="UserWelcomeText" Text="User: user" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UserStatusText" Text="Status: Active" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                                                <TextBlock x:Name="UserExpiryText" Text="Remaining: Lifetime" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Launch Button -->
                                        <Button x:Name="LoadBtn" Content="Launch" Style="{StaticResource SkeetButton}" Height="34" Margin="0,0,0,10" Click="LoadBtn_Click" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="10"/>
                                            </Button.RenderTransform>
                                        </Button>

                                        <!-- Status / Progress -->
                                        <ProgressBar x:Name="LoadProgressBar" Height="4" Margin="0,6,0,6" Background="{StaticResource BgDark}" Foreground="{StaticResource AccentGold}" BorderThickness="0" Visibility="Collapsed" Opacity="0"/>
                                        <TextBlock x:Name="LoaderStatusText" Text="dll file exists" Foreground="{StaticResource TextDim}" FontSize="11" TextAlignment="Center" Opacity="0">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="6"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Status Bar -->
                    <Border Grid.Row="3" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderCol}" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid>
                            <TextBlock Text="terry davis edition" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="pre-release public x64" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
